{
	"name": "@syndie/n8n-nodes-syndie",
	"version": "0.3.2",
	"description": "Syndie for n8n: start workflows when a lead replies, connects, changes status, opts out, is handed to a person or books a meeting, and import or find leads",
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.0.8",
	"keywords": [
		"n8n-community-node-package",
		"syndie",
		"linkedin",
		"outreach",
		"sales",
		"leads",
		"crm"
	],
	"license": "MIT",
	"homepage": "https://syndie.io",
	"author": {
		"name": "Syndie",
		"email": "support@syndie.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Syndie-io/n8n-nodes-syndie"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials --write",
		"test": "node scripts/self-test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"docs",
		"CHANGELOG.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SyndieOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Syndie/SyndieTrigger.node.js",
			"dist/nodes/Syndie/Syndie.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.47.0",
		"@types/node": "^20.19.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
